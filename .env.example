# Token da API de contexto (/api/context). Opcional em dev; obrigatório para a API funcionar com NODE_ENV=production.
# Quando definido, toda requisição precisa de: Authorization: Bearer <token>
BUSINESSOS_API_TOKEN=
# Pasta de conteúdo (padrão: ./content). Usada pelos testes.
BUSINESSOS_CONTENT_DIR=
# Armazenamento: supabase (padrão) | fs (arquivos locais: content/*.md e JSONs; útil em testes e no 1º setup)
BUSINESSOS_STORAGE=supabase

# --- Supabase (projeto BusinessOS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: SÓ servidor/scripts. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Usuário "dono" das chamadas da API de agentes (/api/context com Bearer). Preenchido após criar o admin.
BUSINESSOS_API_USER_ID=

# --- Scripts de admin (NÃO guarde senha aqui; passe na linha de comando) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- IA (cabos soltos): preencha quando tiver a chave ---
ANTHROPIC_API_KEY=
# IA: api | cli | desligada (padrão: api se houver ANTHROPIC_API_KEY, senão cli)
BUSINESSOS_IA=
BUSINESSOS_IA_MODELO=
BUSINESSOS_IA_MAX_TOKENS=

# --- Base de conhecimento (embeddings do Google; só servidor, nunca NEXT_PUBLIC_) ---
# Sem a chave, o chat funciona normalmente, só sem buscar nas páginas e conversas antigas.
GOOGLE_API_KEY=
# Modelo de embeddings (padrão: gemini-embedding-001, com 768 dimensões)
GOOGLE_EMBEDDING_MODELO=
